info: AxiomAudit.lean:4:0: axiom MaxwellMGF.Background.product_density.{u_1} : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (n : ℕ) (V : Ω → EuclideanSpace ℝ (Fin n)),
  Measurable V →
    ∀ (f : ℝ → ℝ),
      Measurable f →
        (∀ (x : ℝ), 0 ≤ f x) →
          MeasureTheory.Integrable f MeasureTheory.volume →
            ∫ (x : ℝ), f x = 1 →
              (MeasureTheory.Measure.map V μ =
                  MeasureTheory.volume.withDensity fun v => ENNReal.ofReal (∏ i, f (v.ofLp i))) →
                ProbabilityTheory.iIndepFun (fun i ω => (V ω).ofLp i) μ ∧
                  ∀ (i : Fin n),
                    MeasureTheory.Measure.map (fun ω => (V ω).ofLp i) μ =
                      MeasureTheory.volume.withDensity fun x => ENNReal.ofReal (f x)
info: AxiomAudit.lean:5:0: axiom MaxwellMGF.Background.gamma_mgf : ∀ (a r t : ℝ),
  0 < a →
    0 < r →
      t < r →
        MeasureTheory.Integrable (fun x => Real.exp (t * x)) (ProbabilityTheory.gammaMeasure a r) ∧
          ProbabilityTheory.mgf id (ProbabilityTheory.gammaMeasure a r) t = (1 - t / r) ^ (-a)
info: AxiomAudit.lean:6:0: axiom MaxwellMGF.Background.mgf_unique.{u_1} : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (X : Ω → ℝ),
  Measurable X →
    ∀ (ν : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure ν] (ε : ℝ),
      0 < ε →
        (∀ (t : ℝ), |t| < ε → MeasureTheory.Integrable (fun ω => Real.exp (t * X ω)) μ) →
          (∀ (t : ℝ), |t| < ε → MeasureTheory.Integrable (fun x => Real.exp (t * x)) ν) →
            (∀ (t : ℝ), |t| < ε → ProbabilityTheory.mgf X μ t = ProbabilityTheory.mgf id ν t) →
              MeasureTheory.Measure.map X μ = ν
