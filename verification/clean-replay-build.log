  MaxwellMGF.Conclusions.squareDefinition : ∀ (i : Fin 3) (ω : Ω),
      MaxwellMGF.squares b V i ω = ((V ω).ofLp i / MaxwellMGF.sigma b) ^ 2
  MaxwellMGF.Conclusions.squaresIndependent : ProbabilityTheory.iIndepFun (MaxwellMGF.squares b V) μ
  MaxwellMGF.Conclusions.squareMGF : ∀ (i : Fin 3),
