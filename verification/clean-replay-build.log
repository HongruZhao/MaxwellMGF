  MaxwellMGF.Conclusions.squareMGFFinite : ∀ (i : Fin 3),
      ∀ t < 1 / 2, MeasureTheory.Integrable (fun ω => Real.exp (t * MaxwellMGF.squares b V i ω)) μ
  MaxwellMGF.Conclusions.squareLaw : ∀ (i : Fin 3),
      MeasureTheory.Measure.map (MaxwellMGF.squares b V i) μ = ProbabilityTheory.gammaMeasure (1 / 2) (1 / 2)
  MaxwellMGF.Conclusions.sumMGF : ∀ t < 1 / 2,
      ProbabilityTheory.mgf (MaxwellMGF.sumSquares b V) μ t = (1 - 2 * t) ^ (-3 / 2)
  MaxwellMGF.Conclusions.sumMGFFinite : ∀ t < 1 / 2,
      MeasureTheory.Integrable (fun ω => Real.exp (t * MaxwellMGF.sumSquares b V ω)) μ
  MaxwellMGF.Conclusions.sumLaw : MeasureTheory.Measure.map (MaxwellMGF.sumSquares b V) μ =
      ProbabilityTheory.gammaMeasure (3 / 2) (1 / 2)
  MaxwellMGF.Conclusions.speedTransform : ∀ (ω : Ω), ‖V ω‖ = MaxwellMGF.sigma b * √(MaxwellMGF.sumSquares b V ω)
