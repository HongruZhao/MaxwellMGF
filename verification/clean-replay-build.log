  MaxwellMGF.Conclusions.speedLaw : MeasureTheory.Measure.map (fun ω => ‖V ω‖) μ = MaxwellDemo.speedLaw b
  MaxwellMGF.Conclusions.speedDensity : ∀ (r : ℝ),
      MaxwellDemo.speedDensity b r =
        if 0 ≤ r then
          √(2 / Real.pi) * r ^ 2 * (MaxwellMGF.sigma b)⁻¹ ^ 3 * Real.exp (-r ^ 2 / (2 * MaxwellMGF.sigma b ^ 2))
        else 0
  MaxwellMGF.Conclusions.speedDensityLaw : MeasureTheory.Measure.map (fun ω => ‖V ω‖) μ =
      MeasureTheory.volume.withDensity fun r => ENNReal.ofReal (MaxwellDemo.speedDensity b r)
  MaxwellMGF.Conclusions.normalized : ∫ (r : ℝ), MaxwellDemo.speedDensity b r = 1
