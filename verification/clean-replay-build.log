  MaxwellMGF.Conclusions.jointGaussian : MeasureTheory.Measure.map (fun ω i => (V ω).ofLp i) μ =
      MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal 0 (MaxwellMGF.varianceParameter b)
  MaxwellMGF.Conclusions.velocityMGF : ∀ (t : Fin 3 → ℝ),
      ProbabilityTheory.mgf (fun ω => ∑ i, t i * (V ω).ofLp i) μ 1 =
        Real.exp ((MaxwellMGF.sigma b ^ 2 * ∑ i, t i ^ 2) / 2)
  MaxwellMGF.Conclusions.velocityMGFFinite : ∀ (t : Fin 3 → ℝ),
